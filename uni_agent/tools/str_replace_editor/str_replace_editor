STATE_FILE = "/root/editor_state.json"
SNIPPET_LINES = 4

# We ignore certain warnings from tree_sitter (optional).
warnings.simplefilter("ignore", category=FutureWarning)

TRUNCATED_MESSAGE = (
    "<response clipped><NOTE>To save on context only part of this file has been shown to you. "
    "You should retry this tool after you have searched inside the file "
    "with `grep -n` in order to find the line numbers of what you are looking for.</NOTE>"
)
MAX_RESPONSE_LEN = 16000
MAX_WINDOW_EXPANSION_VIEW = int(os.getenv("MAX_WINDOW_EXPANSION_VIEW", "0"))
MAX_WINDOW_EXPANSION_EDIT_CONFIRM = int(os.getenv("MAX_WINDOW_EXPANSION_EDIT_CONFIRM", "0"))
USE_FILEMAP = os.getenv("USE_FILEMAP", "true").lower() == "true"
# Failed str_replace calls get a diagnosis (closest region + exact difference) instead of an
# echo of old_str; "false" restores the legacy echo messages byte-for-byte.
EXPLAIN_EDIT_FAILURES = os.getenv("EXPLAIN_EDIT_FAILURES", "true").lower() == "true"
# On a confident near-miss, additionally print the matching file region verbatim with an
# imperative resend line: measured to raise retry self-fixes to 98% (indent) / 83%
# (trailing) / 31% (window) against 19% with the diagnosis alone.
STR_REPLACE_DID_YOU_MEAN = os.getenv("STR_REPLACE_DID_YOU_MEAN", "false").lower() == "true"
DID_YOU_MEAN_MAX_CHARS = 4000
DID_YOU_MEAN_MIN_RATIO = 0.8
EXPLAIN_MAX_FILE_BYTES = 2000000
EXPLAIN_MAX_OLD_LINES = 200
EXPLAIN_MAX_DIFF_LINES = 5


if hasattr(sys.stdout, "buffer"):
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
else:
    # Fallback
    sys.stderr.write("sys.stdout does not have a 'buffer' attribute.")


def safe_print(x):
    try:
        print(x)
    except UnicodeEncodeError:
        print(x.encode("utf-8", errors="replace").decode("utf-8", errors="replace"))


def maybe_truncate(content: str, truncate_after: Optional[int] = MAX_RESPONSE_LEN):
    if not truncate_after or len(content) <= truncate_after:
        return content
    return content[:truncate_after] + TRUNCATED_MESSAGE


def load_history() -> Dict[str, List[str]]:
    """
    Load the file edit history from STATE_FILE if it exists.
    """
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            return {k: v for k, v in data.items()}
    except FileNotFoundError:
        return {}
    except Exception:
        return {}


def save_history(history: Dict[str, List[str]]):
    """
    Save the file edit history to STATE_FILE as JSON.
    """
    try:
        with open(STATE_FILE, "w", encoding="utf-8") as f:
            json.dump(history, f)
    except Exception:
        pass


def _describe_old_str(old_str: str) -> str:
    """Compact identifier for a failed old_str, replacing the full echo."""
    lines = old_str.split("\n")
    first = lines[0].strip()[:60] if lines else ""
    return f"old_str ({len(lines)} lines, {len(old_str)} chars, starting `{first}`)"


def _unique_match_line(needle: str, haystack: str) -> Optional[int]:
    """1-based start line of the only occurrence of needle, else None."""
    idx = haystack.find(needle)
    if idx < 0 or haystack.find(needle, idx + 1) >= 0:
        return None
    return haystack.count("\n", 0, idx) + 1


def _shift_indent(lines: List[str], delta: int) -> Optional[List[str]]:
    """Every non-blank line shifted by delta leading spaces; None if a line is too shallow."""
    out = []
    for line in lines:
        if not line.strip():
            out.append(line)
        elif delta >= 0:
            out.append(" " * delta + line)
        elif line.startswith(" " * -delta):
            out.append(line[-delta:])
        else:
            return None
    return out


def _probe_transforms(old_str: str, file_content: str) -> Optional[Tuple[int, int, str]]:
    """First invertible repair of old_str that matches the file exactly once.

    Returns (start_line, end_line, description-of-what-was-wrong), or None. Probes only
    diagnose; the edit is never applied with a transformed string.
    """
    lines = old_str.split("\n")
    probes: List[Tuple[str, str]] = []
    if "\\n" in old_str:
        n = old_str.count("\\n")
        probes.append(
            (
                old_str.replace("\\n", "\n"),
                f"your old_str contains the 2-character sequence `\\n` ({n}x) where the file "
                "has a real line break -- the escaping collapsed your newlines",
            )
        )
    if "\\t" in old_str:
        probes.append(
            (old_str.replace("\\t", "\t"), "your old_str has literal `\\t` where the file has real tab characters")
        )
    for k in (1, 2, 3, 4, 5, 6, 8, 12):
        for delta in (-k, k):
            shifted = _shift_indent(lines, delta)
            if shifted is None:
                continue
            direction = f"{-delta} extra" if delta < 0 else f"{delta} missing"
            probes.append(
                ("\n".join(shifted), f"every line of your old_str has {direction} leading space(s)")
            )
    stripped = "\n".join(line.rstrip() for line in lines)
    if stripped != old_str:
        probes.append((stripped, "your old_str has trailing whitespace the file does not have"))
    for candidate, description in probes:
        start = _unique_match_line(candidate, file_content)
        if start is not None:
            return start, start + len(lines) - 1, description
    return None


def _match_lenient_lines(old_str: str, file_content: str) -> Optional[Tuple[int, int, str]]:
    """Per-line whitespace-lenient regex match, used to diagnose tab/space and edge-blank mixes."""
    lines = old_str.split("\n")
    pattern = "\n".join("[ \t]*" + re.escape(line.strip()) + "[ \t]*" for line in lines)
    try:
        matches = list(re.finditer(pattern, file_content))
    except re.error:
        return None
    if len(matches) != 1:
        return None
    match = matches[0]
    start = file_content.count("\n", 0, match.start()) + 1
    detail = "only the line-edge whitespace differs"
    for k, (file_line, old_line) in enumerate(zip(match.group().split("\n"), lines)):
        file_ws = file_line[: len(file_line) - len(file_line.lstrip(" \t"))]
        old_ws = old_line[: len(old_line) - len(old_line.lstrip(" \t"))]
        if file_ws != old_ws:
            kind = "tabs" if "\t" in file_ws else f"{len(file_ws)} space(s)"
            detail = (
                f"only the line-edge whitespace differs; e.g. line {start + k} is indented "
                f"with {kind} in the file, not `{old_ws}`"
            )
            break
    return start, start + len(lines) - 1, detail


def _closest_window(old_str: str, file_content: str) -> Optional[Tuple[int, float, List[Tuple[int, str, str]]]]:
    """Best same-length window in the file: (1-based start, ratio, differing line triples)."""
    import difflib

    old_lines = old_str.split("\n")
    file_lines = file_content.split("\n")
    n = len(old_lines)
    starts = set()
    anchors = sorted({line for line in old_lines if len(line.strip()) >= 8}, key=len, reverse=True)
    for anchor in anchors[:5]:
        offset = old_lines.index(anchor)
        for i, file_line in enumerate(file_lines):
            if file_line == anchor or file_line.strip() == anchor.strip():
                starts.add(max(0, i - offset))
        if starts:
            break
    if not starts:
        seed = next((line for line in old_lines if line.strip()), "")
        for close in difflib.get_close_matches(seed, file_lines, n=3, cutoff=0.6):
            starts.add(max(0, file_lines.index(close) - old_lines.index(seed) if seed in old_lines else 0))
    best = None
    for start in sorted(starts):
        window = file_lines[start : start + n]
        ratio = difflib.SequenceMatcher(None, "\n".join(window), old_str, autojunk=False).ratio()
        if best is None or ratio > best[1]:
            best = (start, ratio, window)
    if best is None or best[1] < 0.7:
        return None
    start, ratio, window = best
    diffs = [
        (start + k + 1, file_line, old_line)
        for k, (file_line, old_line) in enumerate(zip(window, old_lines))
        if file_line != old_line
    ]
    return start + 1, ratio, diffs


def _did_you_mean(file_content: str, start: int, end: int) -> str:
    """The matching region as the JSON value to resend; empty when disabled or the region is
    too large for an observation.

    The region is printed escaped rather than raw because the differences that cause these
    failures are the ones raw text cannot show: a trailing space, a tab, a literal ``\\n``.
    Printed raw, a whitespace-only near-miss renders identically to what the model already
    sent, which reads as "resend the same thing" -- and the model does.
    """
    if not STR_REPLACE_DID_YOU_MEAN:
        return ""
    region = "\n".join(file_content.split("\n")[start - 1 : end])
    if not region or len(region) > DID_YOU_MEAN_MAX_CHARS:
        return ""
    return ("\nThe matching region of the file is exactly this JSON value:\n"
            + '"old_str": ' + json.dumps(region)
            + "\nResend the call with this as your old_str, copied character for character.")


def explain_edit_failure(old_str: str, file_content: str) -> str:
    """One compact paragraph saying where old_str nearly matches and how it differs."""
    if len(file_content) > EXPLAIN_MAX_FILE_BYTES or len(old_str.split("\n")) > EXPLAIN_MAX_OLD_LINES:
        return ""
    for finder in (_probe_transforms, _match_lenient_lines):
        found = finder(old_str, file_content)
        if found is not None:
            start, end, description = found
            return (f"Closest match: lines {start}-{end} match exactly except {description}."
                    + _did_you_mean(file_content, start, end))
    window = _closest_window(old_str, file_content)
    if window is None:
        return (
            "No similar region found. View the file or `grep -n` a distinctive line "
            "before retrying, and copy the text exactly as shown."
        )
    start, ratio, diffs = window
    end = start + len(old_str.split("\n")) - 1
    shown = [
        f"  line {line_no}: file has `{file_line.strip()[:70]}`, your old_str has `{old_line.strip()[:70]}`"
        for line_no, file_line, old_line in diffs[:EXPLAIN_MAX_DIFF_LINES]
    ]
    if len(diffs) > EXPLAIN_MAX_DIFF_LINES:
        shown.append(f"  ... and {len(diffs) - EXPLAIN_MAX_DIFF_LINES} more differing line(s)")
    lines = "\n".join(shown) if shown else "  (differences are within lines' whitespace)"
    suggestion = _did_you_mean(file_content, start, end) if ratio >= DID_YOU_MEAN_MIN_RATIO else ""
    return f"Closest match: lines {start}-{end} ({ratio:.0%} similar). Differing lines:\n{lines}{suggestion}"


class Filemap:
    def show_filemap(self, file_contents: str, encoding: str = "utf8"):
        import warnings

        from tree_sitter_languages import get_language, get_parser

        warnings.simplefilter("ignore", category=FutureWarning)

        parser = get_parser("python")
        language = get_language("python")

        tree = parser.parse(bytes(file_contents.encode(encoding, errors="replace")))

        # See https://tree-sitter.github.io/tree-sitter/using-parsers#pattern-matching-with-queries.
        query = language.query("""
        (function_definition
        body: (_) @body)
        """)

        # TODO: consider special casing docstrings such that they are not elided. This
        # could be accomplished by checking whether `body.text.decode('utf8')` starts
        # with `"""` or `'''`.
        elide_line_ranges = [
            (node.start_point[0], node.end_point[0])
            for node, _ in query.captures(tree.root_node)
            # Only elide if it's sufficiently long
            if node.end_point[0] - node.start_point[0] >= 5
        ]
        # Note that tree-sitter line numbers are 0-indexed, but we display 1-indexed.
        elide_lines = {line for start, end in elide_line_ranges for line in range(start, end + 1)}
        elide_messages = [(start, f"... eliding lines {start + 1}-{end + 1} ...") for start, end in elide_line_ranges]
        out = []
        for i, line in sorted(
            elide_messages + [(i, line) for i, line in enumerate(file_contents.splitlines()) if i not in elide_lines]
        ):
            out.append(f"{i + 1:6d} {line}")
        return "\n".join(out)


class WindowExpander:
    def __init__(self, suffix: str = ""):
        """Try to expand viewports to include whole functions, classes, etc. rather than
        using fixed line windows.

        Args:
            suffix: Filename suffix
        """
        self.suffix = suffix
        if self.suffix:
            assert self.suffix.startswith(".")

    def _find_breakpoints(self, lines: List[str], current_line: int, direction=1, max_added_lines: int = 30) -> int:
        """Returns 1-based line number of breakpoint. This line is meant to still be included in the viewport.

        Args:
            lines: List of lines of the file
            current_line: 1-based line number of the current viewport
            direction: 1 for down, -1 for up
            max_added_lines: Maximum number of lines to extend

        Returns:
            1-based line number of breakpoint. This line is meant to still be included in the viewport.
        """
        assert 1 <= current_line <= len(lines)
        assert 0 <= max_added_lines

        # 1. Find line range that we want to search for breakpoints in

        if direction == 1:
            # down
            if current_line == len(lines):
                # already last line, can't extend down
                return current_line
            iter_lines = range(current_line, 1 + min(current_line + max_added_lines, len(lines)))
        elif direction == -1:
            # up
            if current_line == 1:
                # already first line, can't extend up
                return current_line
            iter_lines = range(current_line, -1 + max(current_line - max_added_lines, 1), -1)
        else:
            msg = f"Invalid direction {direction}"
            raise ValueError(msg)

        # 2. Find the best breakpoint in the line range

        # Every condition gives a score, the best score is the best breakpoint
        best_score = 0
        best_breakpoint = current_line
        for i_line in iter_lines:
            next_line = None
            line = lines[i_line - 1]
            if i_line + direction in iter_lines:
                next_line = lines[i_line + direction - 1]
            score = 0
            if line == "":
                score = 1
                if next_line == "":
                    # Double new blank line:
                    score = 2
            if self.suffix == ".py" and any(
                re.match(regex, line) for regex in [r"^\s*def\s+", r"^\s*class\s+", r"^\s*@"]
            ):
                # We include decorators here, because they are always on top of the function/class definition
                score = 3
            if score > best_score:
                best_score = score
                best_breakpoint = i_line
                if direction == 1 and i_line != current_line:
                    best_breakpoint -= 1
            if i_line == 1 or i_line == len(lines):
                score = 3
                if score > best_score:
                    best_score = score
                    best_breakpoint = i_line
            # print(f"Score {score} for line {i_line} ({line})")

        # print(f"Best score {best_score} for line {best_breakpoint} ({lines[best_breakpoint-1]})")
        if direction == 1 and best_breakpoint < current_line or direction == -1 and best_breakpoint > current_line:
            # We don't want to shrink the view port, so we return the current line
            return current_line

        return best_breakpoint

    def expand_window(self, lines: List[str], start: int, stop: int, max_added_lines: int) -> Tuple[int, int]:
        """

        Args:
            lines: All lines of the file
            start: 1-based line number of the start of the viewport
            stop: 1-based line number of the end of the viewport
            max_added_lines: Maximum number of lines to extend (separately for each side)

        Returns:
            Tuple of 1-based line numbers of the start and end of the viewport.
            Both inclusive.
        """
        # print("Input:", start, stop)
        assert 1 <= start <= stop <= len(lines), (start, stop, len(lines))
        if max_added_lines <= 0:
            # Already at max range, no expansion
            return start, stop
        new_start = self._find_breakpoints(lines, start, direction=-1, max_added_lines=max_added_lines)
        new_stop = self._find_breakpoints(lines, stop, direction=1, max_added_lines=max_added_lines)
        # print(f"Expanded window is {new_start} to {new_stop}")
        assert new_start <= new_stop, (new_start, new_stop)
        assert new_start <= start, (new_start, start)
        assert start - new_start <= max_added_lines, (start, new_start)
        assert new_stop >= stop, (new_stop, stop)
        assert new_stop - stop <= max_added_lines, (new_stop, stop)
        return new_start, new_stop


class EditTool:
    """
    An filesystem editor tool that allows the agent to view, create, and edit files.
    The tool parameters are defined by Anthropic and are not editable.
    """

    def __init__(self, file_history: Dict[str, List[str]]):
        self._file_history = defaultdict(list, file_history)
        self._encoding = None

    def run(
        self,
        command: str,
        path_str: str,
        file_text: str = None,
        view_range: List[int] = None,
        old_str: str = None,
        new_str: str = None,
        insert_line: int = None,
    ):
        path = Path(path_str)
        self.validate_path(command, path)

        if command == "view":
            self.view(path, view_range)
        elif command == "create":
            if file_text is None:
                safe_print("Parameter `file_text` is required for command: create")
                sys.exit()
            self.create(path, file_text)
        elif command == "str_replace":
            if old_str is None:
                safe_print("Parameter `old_str` is required for command: str_replace")
                sys.exit()
            self.str_replace(path, old_str, new_str)
        elif command == "insert":
            if insert_line is None:
                safe_print("Parameter `insert_line` is required for command: insert")
                sys.exit()
            if new_str is None:
                safe_print("Parameter `new_str` is required for command: insert")
                sys.exit()
            self.insert(path, insert_line, new_str)
        elif command == "undo_edit":
            self.undo_edit(path)
        else:
            safe_print(
                f"Unrecognized command `{command}`. "
                "The allowed commands for the str_replace_editor are: "
                "`view`, `create`, `str_replace`, `insert`, `undo_edit`"
            )

    def validate_path(self, command: str, path: Path):
        if not path.exists() and command != "create":
            safe_print(f"The path `{path}` does not exist. Please provide a valid path.")
        if path.exists() and command == "create":
            safe_print(f"File already exists at: `{path}`. Cannot overwrite files using command `create`.")
        if path.is_dir() and command != "view":
            safe_print(f"The path `{path}` is a directory and only the `view` command can be used on directories")

    def read_file(self, path: Path):
        encodings = [
            (None, None),
            ("utf-8", None),
            ("latin-1", None),
            ("utf-8", "replace"),
        ]
        exception = None
        for self._encoding, errors in encodings:
            try:
                text = path.read_text(encoding=self._encoding, errors=errors)
                return text
            except UnicodeDecodeError as e:
                exception = e
        else:
            safe_print(f"Ran into UnicodeDecodeError {exception} while trying to read {path}")
            sys.exit()

    def write_file(self, path: Path, content: str):
        try:
            path.write_text(content, encoding=self._encoding or "utf-8")
        except Exception as e:
            safe_print(f"Ran into {e} while trying to write to {path}")
            sys.exit()

    def view(
        self,
        path: Path,
        view_range: Optional[List[int]] = None,
    ):
        if path.is_dir():
            if view_range:
                safe_print("The `view_range` parameter is not allowed when `path` points to a directory.")
                sys.exit()

            cmd = ["find", str(path), "-maxdepth", "2", "-not", "-path", "*/.*"]
            # Try using the newer parameters first (Python 3.7+)
            try:
                proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
            except TypeError:
                # Fallback for Python 3.5 and 3.6 where capture_output and text are not supported
                proc = subprocess.run(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    universal_newlines=True,
                    check=False,
                )

            stderr = proc.stderr.strip()
            stdout = proc.stdout
            if not stderr:
                safe_print(
                    f"Here's the files and directories up to 2 levels deep in `{path}`, "
                    f"excluding hidden items:\n{stdout}\n"
                )
                sys.exit()

        file_content = self.read_file(path)
        if view_range:
            if len(view_range) != 2 or not all(isinstance(i, int) for i in view_range):
                safe_print("Invalid `view_range`. It should be a list of two integers.")
                sys.exit()

            file_lines = file_content.split("\n")
            n_lines_file = len(file_lines)
            init_line, final_line = view_range
            if init_line < 1 or init_line > n_lines_file:
                safe_print(
                    f"Invalid `view_range`: {view_range}. "
                    f"Its first element `{init_line}` should be within the range of lines of the file: {[1, n_lines_file]}"
                )
                sys.exit()
            if final_line > n_lines_file:
                safe_print(
                    f"Invalid `view_range`: {view_range}. "
                    f"Its second element `{final_line}` should be smaller than the number of lines in the file: `{n_lines_file}`"
                )
                sys.exit()
            if final_line != -1 and final_line < init_line:
                safe_print(
                    f"Invalid `view_range`: {view_range}. "
                    f"Its second element `{final_line}` should be larger or equal than its first `{init_line}`"
                )
                sys.exit()

            if final_line == -1:
                final_line = n_lines_file

            # Expand the viewport to include the whole function or class
            init_line, final_line = WindowExpander(suffix=path.suffix).expand_window(
                file_lines, init_line, final_line, max_added_lines=MAX_WINDOW_EXPANSION_VIEW
            )

            file_content = "\n".join(file_lines[init_line - 1 : final_line])
        else:
            if path.suffix == ".py" and len(file_content) > MAX_RESPONSE_LEN and USE_FILEMAP:
                try:
                    filemap = Filemap().show_filemap(file_content, encoding=self._encoding or "utf-8")
                except Exception:
                    # If we fail to show the filemap, just show the truncated file content
                    pass
                else:
                    safe_print(
                        "<NOTE>This file is too large to display entirely. Showing abbreviated version. "
                        "Please use `str_replace_editor view` with the `view_range` parameter to show selected lines next.</NOTE>"
                    )
                    filemap = maybe_truncate(filemap.expandtabs())
                    safe_print(filemap)
                    safe_print(
                        "<IMPORTANT><NOTE>The above file has been abbreviated. "
                        "Please use `str_replace_editor view` with `view_range` to look at relevant files in detail.</NOTE></IMPORTANT>"
                    )
                    return
            # Else just show
            init_line = 1

        # init_line is 1-based
        safe_print(self._make_output(file_content, str(path), init_line=init_line))

    def create(self, path: Path, file_text: str):
        if not path.parent.exists():
            safe_print(f"The parent directory {str(path.parent)} does not exist. Please create it first.")
            sys.exit()

        self.write_file(path, file_text)
        self._file_history[str(path)].append(file_text)
        message = f"File created successfully at: {path}"
        if EXPLAIN_EDIT_FAILURES and path.suffix == ".py":
            lint_error = self._lint_check(file_text, str(path))
            if lint_error:
                # e.g. a literal `\n` from collapsed JSON escaping writes broken code silently
                message += f"\nWarning: the created file does not parse as Python: {lint_error[:200]}"
        safe_print(message)

    def str_replace(self, path: Path, old_str: str, new_str: Optional[str]):
        """Implement the str_replace command, which replaces old_str with new_str in the file content"""
        if new_str is None:
            new_str = ""

        ## "Loose Tools" change
        old_str = old_str.strip("\n\r")
        new_str = new_str.strip("\n\r")

        file_content = self.read_file(path)

        pattern = re.escape(old_str)
        occurrences = [
            (
                file_content.count("\n", 0, match.start()) + 1,  # line number
                match.group(),  # matched text
                match.start(),  # start position
            )
            for match in re.finditer(pattern, file_content)
        ]

        if not occurrences:
            # We found no occurrences, possibly because of extra white spaces at either the front or back of the string.
            # Remove the white spaces and try again.
            original_old_str = old_str
            old_str = old_str.strip()
            new_str = new_str.strip()
            pattern = re.escape(old_str)
            occurrences = [
                (
                    file_content.count("\n", 0, match.start()) + 1,  # line number
                    match.group(),  # matched text
                    match.start(),  # start position
                )
                for match in re.finditer(pattern, file_content)
            ]
            if not occurrences:
                if EXPLAIN_EDIT_FAILURES:
                    # No echo of old_str: the agent just wrote it, and repeated copies both
                    # bloat the context and prime the model to repeat the same failed call.
                    # Diagnose the pre-strip string: the strip() fallback de-indents only the
                    # first line, which would break the uniform-indent probe.
                    message = (
                        f"No replacement was performed, {_describe_old_str(original_old_str)} "
                        f"did not appear verbatim in {path}."
                    )
                    explanation = explain_edit_failure(original_old_str, file_content)
                    if explanation:
                        message += "\n" + explanation
                    safe_print(message)
                else:
                    safe_print(f"No replacement was performed, old_str `{old_str}` did not appear verbatim in {path}.")
                sys.exit()

        if len(occurrences) > 1:
            line_numbers = sorted({line for line, _, _ in occurrences})
            if EXPLAIN_EDIT_FAILURES:
                safe_print(
                    f"No replacement was performed. Multiple occurrences of {_describe_old_str(old_str)} "
                    f"in lines {line_numbers}. Please include enough surrounding context to make it unique."
                )
            else:
                safe_print(
                    f"No replacement was performed. Multiple occurrences of old_str `{old_str}` in lines {line_numbers}. Please ensure it is unique."
                )
            sys.exit()

        if new_str == old_str:
            if EXPLAIN_EDIT_FAILURES:
                safe_print("No replacement was performed, old_str is the same as new_str (nothing would change).")
            else:
                safe_print(f"No replacement was performed, old_str `{old_str}` is the same as new_str `{new_str}`.")
            sys.exit()

        # We found exactly one occurrence
        replacement_line, matched_text, idx = occurrences[0]

        # Create new content by replacing just the matched text
        new_file_content = file_content[:idx] + new_str + file_content[idx + len(matched_text) :]

        # Write the new content to the file
        self.write_file(path, new_file_content)

        # Save the content to history
        self._file_history[path].append(file_content)

        # Create a snippet of the edited section
        replacement_line = file_content.count("\n", 0, idx)
        start_line = max(1, replacement_line - SNIPPET_LINES)
        end_line = min(replacement_line + SNIPPET_LINES + new_str.count("\n"), len(new_file_content.splitlines()))
        start_line, end_line = WindowExpander(suffix=path.suffix).expand_window(
            new_file_content.split("\n"), start_line, end_line, max_added_lines=MAX_WINDOW_EXPANSION_EDIT_CONFIRM
        )
        snippet = "\n".join(new_file_content.split("\n")[start_line - 1 : end_line])

        # Prepare the success message
        success_msg = f"The file {path} has been edited. "
        success_msg += self._make_output(snippet, f"a snippet of {path}", start_line)
        success_msg += "Review the changes and make sure they are as expected. Edit the file again if necessary."
        if EXPLAIN_EDIT_FAILURES and path.suffix == ".py" and not self._lint_check(file_content, str(path)):
            lint_error = self._lint_check(new_file_content, str(path))
            if lint_error:
                success_msg += f"\nWarning: this edit introduced a Python syntax error: {lint_error[:200]}"

        safe_print(success_msg)

    def insert(self, path: Path, insert_line: int, new_str: str):
        """Implement the insert command, which inserts new_str at the specified line in the file content."""
        file_text = self.read_file(path).expandtabs()
        new_str = new_str.expandtabs()
        file_text_lines = file_text.split("\n")
        n_lines_file = len(file_text_lines)
        insert_line -= 1  # Convert to 0-based index

        if insert_line < 0 or insert_line > n_lines_file:
            safe_print(
                f"Invalid `insert_line` parameter: {insert_line}. "
                f"It should be within the range of lines of the file: {[0, n_lines_file]}"
            )
            sys.exit()

        new_str_lines = new_str.split("\n")
        new_file_text_lines = file_text_lines[:insert_line] + new_str_lines + file_text_lines[insert_line:]
        snippet_lines = (
            file_text_lines[max(0, insert_line - SNIPPET_LINES) : insert_line]
            + new_str_lines
            + file_text_lines[insert_line : insert_line + SNIPPET_LINES]
        )

        new_file_text = "\n".join(new_file_text_lines)
        snippet = "\n".join(snippet_lines)

        self.write_file(path, new_file_text)
        self._file_history[path].append(file_text)

        # todo: Also expand these windows

        success_msg = f"The file {path} has been edited. "
        success_msg += self._make_output(
            snippet,
            "a snippet of the edited file",
            max(1, insert_line - SNIPPET_LINES + 1),
        )
        success_msg += (
            "Review the changes and make sure they are as expected (correct indentation, no duplicate lines, etc). "
            "Edit the file again if necessary."
        )
        safe_print(success_msg)

    def undo_edit(self, path: Path):
        """Implement the undo_edit command."""
        if not self._file_history[path]:
            safe_print(f"No edit history found for {path}.")
            sys.exit()

        old_text = self._file_history[path].pop()
        self.write_file(path, old_text)

        safe_print(f"Last edit to {path} undone successfully. {self._make_output(old_text, str(path))}")

    def _make_output(
        self,
        file_content: str,
        file_descriptor: str,
        init_line: int = 1,
        expand_tabs: bool = True,
    ) -> str:
        """
        Mimics cat -n style numbering, plus maybe_truncate to avoid huge outputs.
        """
        file_content = maybe_truncate(file_content)
        if expand_tabs:
            file_content = file_content.expandtabs()
        lines = file_content.split("\n")
        numbered_content = "\n".join([f"{i + init_line:6}\t{line}" for i, line in enumerate(lines)])
        return f"Here's the result of running `cat -n` on {file_descriptor}:\n{numbered_content}\n"

    def _lint_check(self, new_content: str, file_path: str) -> str:
        import ast

        try:
            ast.parse(new_content, filename=file_path)
            return ""
        except SyntaxError as e:
            return str(e)


def main():
    def parse_view_range(range_str: str):
        # Remove surrounding brackets if present
        range_str = range_str.strip().strip("[]()")

        # Split on commas or whitespace
        parts = range_str.replace(",", " ").split()

        try:
            assert len(parts) == 2
            start_line = int(parts[0])
            end_line = int(parts[1])
        except Exception:
            safe_print("Invalid `view_range`. It should be a list of two integers.")
            sys.exit()

        return [start_line, end_line]

    parser = argparse.ArgumentParser()
    parser.add_argument("command", type=str)
    parser.add_argument("--path", type=str)
    parser.add_argument("--file_text", type=str, default=None)
    parser.add_argument("--view_range", type=parse_view_range, default=None)
    parser.add_argument("--old_str", type=str, default=None)
    parser.add_argument("--new_str", type=str, default=None)
    parser.add_argument("--insert_line", type=int, default=None)

    args = parser.parse_args()

    file_history = load_history()
    editor = EditTool(file_history)

    editor.run(
        command=args.command,
        path_str=args.path,
        file_text=args.file_text,
        view_range=args.view_range,
        old_str=args.old_str,
        new_str=args.new_str,
        insert_line=args.insert_line,
    )
    save_history(dict(editor._file_history))


if __name__ == "__main__":
    main()
